{
	"schemaVersion": 1,
	"id": "mysticalplantslg",
	"version": "${version}",
	"name": "Mystical Plants Legacy",
	"description": "Adds 5 types of magical plants that can be useful or dangerous",
	"authors": [
		"ExperionPlanet"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "ExperionPlanet-License-1.0",
	"icon": "assets/mysticalplantslg/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.experionplanet.mysticalplantslg.MPLMain"
		],
		"client": [
			"io.github.experionplanet.mysticalplantslg.MPLClient"
		],
		"fabric-datagen": [
			"io.github.experionplanet.mysticalplantslg.MPLDataGen"
		],
		"jade": [
			"io.github.experionplanet.mysticalplantslg.compat.MPLJade"
		],
		"modmenu": [
			"io.github.experionplanet.mysticalplantslg.compat.MPLModMenu"
		]
	},
	"mixins": [
		"mysticalplantslg.mixins.json",
		{
			"config": "mysticalplantslg.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}